# ============================================================
# Entorno local de desarrollo — COBRANZA APP
# Copiar a .env y ajustar valores locales.
# NUNCA agregar .env a Git. Este archivo sí se versiona.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL / PostGIS
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cobranza_db
POSTGRES_USER=cobranza_dev
POSTGRES_PASSWORD=cambiar_esto_en_local

# ------------------------------------------------------------
# Adminer (administrador de base de datos — perfil opcional)
# ------------------------------------------------------------
ADMINER_PORT=8080

# ------------------------------------------------------------
# Red interna de Docker
# ------------------------------------------------------------
NETWORK_NAME=cobranza_net

# ------------------------------------------------------------
# Proyecto Docker Compose
# ------------------------------------------------------------
COMPOSE_PROJECT_NAME=cobranza

# ------------------------------------------------------------
# API — Autenticación Web (Fase 5A)
# ------------------------------------------------------------
# Origen permitido para validación de Origin/Referer en /web/refresh y /web/logout
WEB_ALLOWED_ORIGIN=http://localhost:4200
# Marcar la cookie rt_web como Secure en producción (HTTPS)
WEB_COOKIE_SECURE=false
