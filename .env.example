# ============================================================
# Entorno local de desarrollo — COBRANZA APP
# Copiar a .env y ajustar valores locales.
# NUNCA agregar .env a Git. Este archivo sí se versiona.
# ============================================================

# ------------------------------------------------------------
# Proyecto Docker Compose
# ------------------------------------------------------------
COMPOSE_PROJECT_NAME=cobranza

# ------------------------------------------------------------
# PostgreSQL / PostGIS
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cobranza_db
POSTGRES_USER=cobranza_dev
POSTGRES_PASSWORD=cambiar_esto_en_local

# ------------------------------------------------------------
# Puertos expuestos en el host
# ------------------------------------------------------------
# Admin web (Nginx): punto de entrada principal para el navegador
ADMIN_WEB_PORT=8080
# API directa: acceso a Swagger UI y Actuator
API_PORT=8081

# ------------------------------------------------------------
# API — Autenticación Web
# ------------------------------------------------------------
# Origen permitido para validación de Origin en /web/refresh y /web/logout
# En Docker local: usar el puerto de admin-web (mismo origen desde el navegador)
WEB_ALLOWED_ORIGIN=http://localhost:8080
# Marcar la cookie rt_web como Secure (activar en producción con HTTPS)
WEB_COOKIE_SECURE=false

# ------------------------------------------------------------
# API — JWT RSA
# Las claves se generan con: ./scripts/generar-claves.sh
# No versionar las claves. Se montan en el contenedor desde infrastructure/dev-keys/
# ------------------------------------------------------------
JWT_ISSUER=cobranza-api-dev
JWT_AUDIENCE=cobranza-api
JWT_KID=cobranza-rsa-2026-01

# ------------------------------------------------------------
# Usuario local de desarrollo (solo en entorno Docker)
# Requiere: SPRING_PROFILES_ACTIVE=docker y DEV_SEED_ENABLED=true
# El usuario se crea idempotentemente al iniciar la API.
# ------------------------------------------------------------
DEV_SEED_ENABLED=true
DEV_ADMIN_USERNAME=admin.local
DEV_ADMIN_PASSWORD=cambiar_esto_en_local
DEV_ADMIN_EMAIL=admin.local@dev.cl
DEV_ADMIN_ROL=TECNOLOGIA

# ------------------------------------------------------------
# Red interna de Docker
# ------------------------------------------------------------
NETWORK_NAME=cobranza_net

# ------------------------------------------------------------
# Adminer (administrador de base de datos — perfil opcional)
# Activar con: docker compose --profile tools up -d
# ------------------------------------------------------------
ADMINER_PORT=8082
