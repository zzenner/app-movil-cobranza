# Copiar como local.properties (ignorado por Git) y ajustar las rutas locales.
# El archivo local.properties NO se versiona.

# Ruta al Android SDK en la máquina local.
# En Windows con WSL2, usar una ruta accesible desde Linux.
sdk.dir=/home/msalazar/Android/Sdk

# Nota de conectividad local:
# La URL de la API se configura en core/network/build.gradle.kts (BuildConfig.BASE_URL).
# Para el emulador Android: 10.0.2.2 apunta al localhost del host (la máquina de desarrollo).
# Puerto 8081 del host → contenedor Docker de la API Spring Boot.
# Puerto 8080 del host → contenedor Docker de Admin Web (nginx). NO usar para la API.
# Para dispositivo físico, cambiar BASE_URL en build.gradle.kts a la IP de la máquina de desarrollo.
