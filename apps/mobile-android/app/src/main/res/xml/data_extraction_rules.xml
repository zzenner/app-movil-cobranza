<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extracción de datos para Android 12+ (API 31+).
    Excluye TODOS los datos de la app de respaldos en la nube y transferencias de dispositivo.

    Justificación (aplicación corporativa):
    - Los tokens de sesión y material criptográfico no deben migrar entre dispositivos.
    - La clave AES del Android Keystore es intransferible por diseño.
    - El identificadorInstalacion identifica el dispositivo físico; no debe clonarse.
    - Datos financieros de cobranza no deben persistir fuera del dispositivo autorizado.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
